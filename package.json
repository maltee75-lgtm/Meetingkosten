{
  "name": "meetingkosten",
  "version": "1.0.0",
  "description": "Live-Kostenzähler für Meetings - Teilnehmer und Stundensatz eingeben, Start drücken, Kosten laufen im Sekundentakt mit.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "python3 -m http.server 8080",
    "test": "node --test tests/*.test.js",
    "build": "node tools/build-standalone.mjs",
    "build:icons": "node tools/build-icons.mjs",
    "build:screenshots": "node tools/build-screenshots.mjs",
    "package": "npm run build && bash tools/build-package.sh"
  },
  "keywords": [
    "meeting",
    "kosten",
    "stoppuhr",
    "rechner",
    "pwa"
  ],
  "license": "UNLICENSED"
}
